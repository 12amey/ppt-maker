{
  "_comment": "Presenton SDXL Image Generation Workflow. The node titled 'Input Prompt' is where the AI-generated text prompt gets injected. Do not rename that node.",
  "1": {
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load SDXL Checkpoint" }
  },
  "2": {
    "inputs": {
      "text": "professional presentation background, modern design, clean",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Input Prompt" }
  },
  "3": {
    "inputs": {
      "text": "text, watermark, blurry, low quality, distorted, ugly, bad composition",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Image Size" }
  },
  "5": {
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" }
  },
  "6": {
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "7": {
    "inputs": { "filename_prefix": "presenton_image", "images": ["6", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
